{
  "extends": "../searsuite/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@searsuite/*": ["../searsuite-browser/packages/*/src", "../searsuite-pro/packages/*/src", "../searsuite/packages/*/src"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "vite.config.ts"]
}
